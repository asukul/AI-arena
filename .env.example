# AI Arena environment variables. Copy to .env (which is gitignored) for local dev.
# In production these are loaded from GCP Secret Manager, not from .env.

# --- GCP project ---
GCP_PROJECT_ID=ai-arena-platform
GCP_PROJECT_NUMBER=77646749251
GCP_REGION=us-central1

# --- Cloud Tasks ---
TASKS_QUEUE_ID=d4-arena-submissions
# Cloud Run URL the worker handler is exposed on (set after first deploy):
EVALUATOR_TARGET_URL=https://d4-arena-api-XXXX.run.app/internal/evaluate
# Service account email Cloud Tasks uses for OIDC auth on the target URL:
TASKS_INVOKER_SA=d4-arena-tasks-invoker@ai-arena-platform.iam.gserviceaccount.com

# --- Firestore ---
# Uses GCP_PROJECT_ID by default; override only for multi-project setups.
# FIRESTORE_DATABASE_ID=(default)

# --- Canvas ---
CANVAS_BASE_URL=https://canvas.iastate.edu
CANVAS_API_TOKEN=replace-with-token-from-secret-manager
CANVAS_WEBHOOK_SECRET=replace-with-shared-hmac-secret

# --- Anthropic API (judge) ---
# Production: load from Secret Manager → mount as env var on Cloud Run.
ANTHROPIC_API_KEY=replace-with-key-from-console.anthropic.com
# Optional override:
# JUDGE_DEFAULT_MODEL=claude-haiku-4-5
# JUDGE_REGRADE_MODEL=claude-opus-4-7

# --- Submission limits ---
RATE_LIMIT_PER_DAY=5
# Per-student daily judge-token budget. Drains across all judge calls a
# student's submissions trigger; resets at UTC midnight. Default 50,000.
DAILY_TOKEN_BUDGET=50000

# --- Cross-family re-grade pass (optional) ---
# Used by evaluator/regrade.py to re-score the top 10% of submissions
# with a different model family. Lazy-imported — leave blank to disable.
GEMINI_API_KEY=

# --- Local dev convenience ---
# Set to "1" to run with in-memory queue and stub Firestore client (no GCP needed).
ARENA_LOCAL_DEV=0
LOG_LEVEL=INFO
